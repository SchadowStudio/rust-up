# ISOLATED STAGING ONLY. Not rustup-bot and not rustup-stats.
# Copy to payments/wrangler.stars.toml and substitute staging D1 UUID.
name = "rustup-stars-staging"
main = "integration/telegram-stars/worker.mjs"
compatibility_date = "2026-11-04"
workers_dev = true

[vars]
STARS_PAYMENT_ENABLED = "false"
STARS_VARIABLE_TOPUP_ENABLED = "false"
STARS_FIXED_PRODUCTS_ENABLED = "false"
# Two-stage admin safety gates: /pay commands can never bypass these values.
PAYMENT_PRODUCTION_ENABLED = "false"
EXTERNAL_VARIABLE_CRYPTO_CHECKOUT_ENABLED = "false"
CRYPTO_GATEWAY_CONNECTED = "false"
PAYMENT_BOT_USERNAME = "rustuper_bot"
# Set PAYMENT_ADMIN_IDS in Cloudflare secrets, not in this file.
# Required before ANY variable Stars quote. Owner must decide the rate.
# Example: 300 kopeks per Star would mean 1 Star = 3 RUB, NOT a Telegram market rate.
STARS_MIN_RUB_MINOR = ""
STARS_MAX_RUB_MINOR = ""
STARS_RUB_MINOR_PER_STAR_NUM = ""
STARS_RUB_MINOR_PER_STAR_DEN = ""
STARS_ALLOWED_ORIGIN = "https://example.invalid"

[[d1_databases]]
binding = "DB"
database_name = "rustup-stars-staging"
database_id = "REPLACE_WITH_NEW_STAGING_D1_ID"

# REQUIRED: a separate TEST bot, never the existing RUST UP Telegram bot
# npx wrangler secret put TG_STARS_BOT_TOKEN --config wrangler.stars.toml
# npx wrangler secret put TG_STARS_WEBHOOK_SECRET --config wrangler.stars.toml
# Do not commit these values.
